<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
  <!-- Courseware-mandated harness class name; the 'IT' suffix marks surefire-excluded smoke tests. -->
  <suppress checks="AbbreviationAsWordInName" files="ProviderSmokeIT\.java"/>
  <!-- Courseware-mandated harness class name(26 节);本类无外部依赖、默认组执行,IT 仅为课件既定字面量。 -->
  <suppress checks="AbbreviationAsWordInName" files="WebSmokeIT\.java"/>
  <!-- 第 27 节指定类名;只豁免名称缩写,不改变 integration 标签或任何行为断言。 -->
  <suppress checks="AbbreviationAsWordInName" files="HumanTriggerFlowIT\.java"/>
  <suppress checks="AbbreviationAsWordInName" files="MockAgentE2ETest\.java"/>
</suppressions>
